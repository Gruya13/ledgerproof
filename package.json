    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  }
}
